FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY train.py app.py ./

# Bake a fresh scoring bundle into the image at build time (deterministic:
# RANDOM_SEED in src/config.py fixes the synthetic data and fit).
RUN python train.py

EXPOSE 8000
CMD uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}
